# Konsolai environment overrides. Unset variables keep the config file or built-in default.
# A database password belongs in ~/.pgpass, not in the URL.
# OpenAI-compatible API base for the main role
KONSOLAI_ENDPOINT=http://localhost:8000/v1
# empty uses the server default
KONSOLAI_MODEL=
# fast model API base; empty leaves the fast role unchanged
KONSOLAI_FAST_ENDPOINT=
# fast model id
KONSOLAI_FAST_MODEL=
# embedding service URL
KONSOLAI_EMBED_ENDPOINT=
# rerank service URL
KONSOLAI_RERANK_ENDPOINT=
# Postgres URL; empty disables memory
KONSOLAI_DATABASE_URL=postgres://user@localhost:5432/konsolai
# plan_step | until_plan
KONSOLAI_BUILD_THINKING=plan_step

# Docker Compose. These are not config keys and /set does not write them.
# compose.yaml reads KONSOLAI_DB_PASSWORD from the environment. Use a private value.
KONSOLAI_DB_PASSWORD=change-me
# Published host port for the compose database.
KONSOLAI_DB_PORT=55434
# Image stage passed to docker build: base or full.
KONSOLAI_TARGET=base
# Host directory mounted at /work.
KONSOLAI_WORKDIR=.
# Config file mounted at /config/config.yaml.
KONSOLAI_CONFIG_FILE=./config.yaml
# Model id for the optional embedding service. Override to use another model.
KONSOLAI_EMBED_MODEL=BAAI/bge-base-en-v1.5
# Published host port for the optional embedding service.
KONSOLAI_EMBED_PORT=8080
