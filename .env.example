# Konsolai environment overrides. Unset variables keep the config file or built-in default.
# A database password belongs in ~/.pgpass, not in the URL.
# OpenAI-compatible API base for the main role
KONSOLAI_ENDPOINT=http://localhost:8000/v1
# empty uses the server default
KONSOLAI_MODEL=
# fast model API base; empty leaves the fast role unchanged
KONSOLAI_FAST_ENDPOINT=
# fast model id
KONSOLAI_FAST_MODEL=
# embedding service URL
KONSOLAI_EMBED_ENDPOINT=
# rerank service URL
KONSOLAI_RERANK_ENDPOINT=
# Postgres URL; empty disables memory
KONSOLAI_DATABASE_URL=postgres://user@localhost:5432/konsolai
# plan_step | until_plan
KONSOLAI_BUILD_THINKING=plan_step
